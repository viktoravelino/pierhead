# Copy to .env.lab (gitignored) for `bun run lab`. Paths only, no secrets.
DOKKU_SSH_HOST=192.168.2.13
DOKKU_SSH_PORT=22
DOKKU_SSH_USER=dokku
DOKKU_SSH_KEY=$HOME/.ssh/homelab
DOKKU_SSH_KNOWN_HOSTS=$HOME/.ssh/known_hosts

# PIERHEAD_ALLOW_WRITES is deliberately absent: this server must stay read-only against
# the real host (scripts/lab.sh unsets it anyway).

# Host metrics: Glances container on the VM, bound to the LAN address (see homelab config/dokku).
# GLANCES_URL=http://192.168.2.13:61208
